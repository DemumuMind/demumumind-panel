// Add this block inside the top-level "provider": { ... } object
// in ~/.config/opencode/opencode.jsonc (merge with your existing providers).
{
  "provider": {
    "demumumind": {
      "name": "DemumuMind",
      "env": ["DEMUMUMIND_API_KEY"],
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://test-sprite-busun.sprites.app/demumumind/v1",
        "apiKey": "$DEMUMUMIND_API_KEY"
      },
      "models": {
        "z-ai/glm-5.2:free": {
          "name": "GLM 5.2 Free"
        },
        "minimax/minimax-m3:free": {
          "name": "MiniMax M3 Free"
        },
        "gpt-5.6-sol": {
          "name": "GPT 5.6 Sol"
        }
      }
    }
  }
}
